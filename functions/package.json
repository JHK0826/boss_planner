{
  "name": "boss-planner-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": { "node": "22" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-boss-planner \"vitest run test/rules\"",
    "serve": "npm run build && firebase emulators:start --project demo-boss-planner"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.0",
    "@types/node": "^22.0.0",
    "firebase": "^11.0.0",
    "firebase-tools": "^14.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
